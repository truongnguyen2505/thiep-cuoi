{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thiep-cuoi-duc-truong-thuy-quynh-preview",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
